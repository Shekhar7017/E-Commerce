# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="L'Atelier Haute Boutique"
NODE_ENV=development

# ---- MongoDB Atlas ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/latelier?retryWrites=true&w=majority

# ---- Auth.js / NextAuth ----
AUTH_SECRET=replace-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- JWT (custom API tokens, password reset) ----
JWT_SECRET=replace-with-openssl-rand-base64-32
JWT_RESET_SECRET=replace-with-openssl-rand-base64-32

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# ---- Email (Nodemailer - password reset / order emails) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="L'Atelier Haute Boutique <no-reply@latelier.com>"

# ---- Rate limiting (Upstash Redis) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Admin bootstrap (used only by seed script) ----
ADMIN_EMAIL=admin@latelier.com
ADMIN_PASSWORD=ChangeMe123!
